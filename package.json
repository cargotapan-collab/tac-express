{
  "name": "tac-express",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "audit:auth-boundary": "node scripts/audit-auth-boundary.mjs",
    "audit:governance": "node scripts/audit-governance.mjs",
    "audit:design-spec": "node scripts/audit-design-spec.mjs",
    "supabase:types": "supabase gen types typescript --local > packages/database/src/database.types.ts",
    "supabase:reset": "supabase db reset",
    "supabase:start": "supabase start",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=smoke",
    "e2e:a11y": "playwright test --project=a11y",
    "e2e:visual": "playwright test --project=visual-light --project=visual-dark",
    "e2e:visual:update": "playwright test --project=visual-light --project=visual-dark --update-snapshots",
    "audit:skills": "npx tsx scripts/audit-skills.ts",
    "audit:all": "pnpm audit:governance && pnpm audit:auth-boundary && pnpm audit:skills && pnpm audit:design-spec"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js-pure",
      "esbuild",
      "msw",
      "sharp"
    ]
  }
}
