NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"

# ─── WhatsApp (WPBox / chat.leminai.com) ─────────────────────────────────
# Server-side only. NEVER prefix with NEXT_PUBLIC_ — these must not be
# exposed to the browser bundle.
# Used by: apps/dashboard/app/api/whatsapp/{send-invoice,test}/route.ts

# Kill switch. The routes return 503 immediately when this is anything
# other than the literal string "true" — typo-safe by design. Flip to
# "false" or unset to disable sends without a redeploy when Lemin AI
# changes their template schema, has an outage, or you need to halt
# operationally for any other reason. Defaults to disabled (`false`).
WHATSAPP_ENABLED="true"

WPBOX_API_TOKEN="your-wpbox-api-token"
WPBOX_USER_ID="your-wpbox-user-id"
# Optional — defaults to https://chat.leminai.com if unset.
# WPBOX_BASE_URL="https://chat.leminai.com"

# ─── Invoice PDF signing ─────────────────────────────────────────────────
# HMAC-SHA256 secret used to sign the public /api/public/invoice-pdf URLs
# attached to WhatsApp template messages. WhatsApp's servers fetch these
# URLs without auth — the HMAC signature on the URL itself proves the
# request was authorised by the dashboard.
#
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Server-side only. Minimum 32 bytes / 64 hex chars (this HMAC is the
# only auth boundary on the public /api/public/invoice-pdf route).
# Rotating this invalidates already-sent WhatsApp message URLs
# (acceptable — they're short-lived).
INVOICE_PDF_SIGNING_SECRET="generate-a-32-byte-hex-string"

# ─── Company / bank details rendered on the invoice PDF ──────────────────
# REQUIRED in production. These render directly into a legal tax document,
# so missing values fail the PDF render with a loud error rather than
# silently shipping a placeholder GSTIN / account number to a customer.
#
# COMPANY_ADDRESS uses pipe `|` as a line separator (e.g. "Line 1|Line 2").
COMPANY_LEGAL_NAME="Tapan Associate Cargo"
COMPANY_ADDRESS="Imphal, Manipur, India — 795001"
COMPANY_TEL="+91 385 000 0000"
COMPANY_EMAIL="ops@tapanassociatecargo.in"
COMPANY_WEB="tapanassociatecargo.in"
COMPANY_GSTIN="14AAAAA0000A1Z5"
COMPANY_PAN="AAAAA0000A"
COMPANY_CIN="U63090ML2024PTC012345"

BANK_NAME="State Bank of India · Imphal Main Branch"
BANK_ACCOUNT="0000 0000 0000 0000"
BANK_IFSC="SBIN0000000"
BANK_SWIFT="SBININBBXXX"
BANK_UPI="company-upi-id@bank"

# Optional — explicitly select which approved WPBox template to use for
# invoice sends. Falls back to a name-pattern match (`*invoice*`) and
# then to the single approved template if exactly one exists. Leaving
# this unset is fine when there's only one approved invoice template.
# NEXT_PUBLIC_WHATSAPP_INVOICE_TEMPLATE="tac_express_corridor_invoice"

# ─── Sentry — error telemetry & alerting ─────────────────────────────────
# REQUIRED in production. The dashboard's payment-response-lost handler
# (apps/dashboard/app/(dashboard)/finance/[id]/invoice-detail-client.tsx)
# calls Sentry.captureException() with module=finance, kind=payment_response_lost
# tags. Without a configured DSN, that capture is a SILENT NO-OP.
#
# Project: tapan-cargo-az/javascript-nextjs on de.sentry.io
# Org/project are also referenced in apps/dashboard/next.config.mjs for
# source map uploads — keep both in sync if you migrate projects.
#
# Setup:
#   1. Copy the DSN from Sentry → Settings → Projects → javascript-nextjs → Client Keys
#   2. Set both vars below in your deploy environment (Vercel etc.)
#   3. (Recommended) Set up an alert rule in Sentry:
#      Filter: tags[kind]:payment_response_lost → notify ops within 5min
#      This is the trigger condition the route handler tags for.
#
# Server-side DSN (Node.js + Edge runtimes).
SENTRY_DSN=""
# Browser DSN (same value as SENTRY_DSN unless you split projects).
NEXT_PUBLIC_SENTRY_DSN=""

# Environment label (production / staging / preview / development).
# Defaults to NODE_ENV if unset. The Sentry init reads this so alert
# rules can filter on `environment:production` (see docs/runbooks/
# sentry-alert-rules.md).
# SENTRY_ENV="production"
# NEXT_PUBLIC_SENTRY_ENV="production"

# Release tag — bind events to a git sha / version so source maps line
# up and "First seen in release X" works. Vercel exposes
# VERCEL_GIT_COMMIT_SHA at build time; wire it through to both vars.
# SENTRY_RELEASE="<git-sha>"
# NEXT_PUBLIC_SENTRY_RELEASE="<git-sha>"

# ─── Sentry release-management (CI builds — for source map uploads) ──────
# Used by the @sentry/nextjs build plugin (wrapped via withSentryConfig
# in apps/dashboard/next.config.mjs) to upload source maps so production
# stack traces are readable. ALSO used by `scripts/sentry/create-alert-rules.mjs`
# to provision the canonical alert rules (see docs/runbooks/sentry-alert-rules.md).
#
# Set ONLY in CI / owner's local env — never commit a real auth token.
#   SENTRY_AUTH_TOKEN=  # generate at Settings → Account → API → Auth Tokens
#                       # required scopes:
#                       #   - source-map uploads: project:releases, project:read
#                       #   - alert-rule provisioning: project:write
#                       # A user-auth (sntryu_) token covers both by default.

# ─── Sentry alert-rule notification target (issue #94) ──────────────────────
# Owner-runnable knob for the explicitly-targeted production-errors alert
# rule (canonical rule 6 in scripts/sentry/canonical-rules.mjs). Rules 1–5
# fall back to the org-default IssueOwners email; rule 6 needs an explicit
# channel because it's the "make sure on-call actually gets paged" rule.
#
# The value is the JSON body of Sentry's Issue Alert action — pasted as a
# single line. Set this BEFORE running create-alert-rules.mjs to provision
# rule 6. If unset, the script skips rule 6 with a clear warning; rules 1–5
# provision normally.
#
# Pick ONE of the three shapes below:
#
#   Email to a specific Sentry org member (requires their member id from
#   https://tapan-cargo-az.sentry.io/settings/members/):
#     SENTRY_ALERT_NOTIFICATION_ACTION='{"id":"sentry.mail.actions.NotifyEmailAction","targetType":"Member","targetIdentifier":"42","fallthroughType":"ActiveMembers"}'
#
#   Slack channel (requires the Slack integration installed at
#   https://tapan-cargo-az.sentry.io/settings/integrations/slack/):
#     SENTRY_ALERT_NOTIFICATION_ACTION='{"id":"sentry.integrations.slack.notify_action.SlackNotifyServiceAction","workspace":"<numeric workspace id>","channel":"#tac-incidents","channel_id":"<channel id>","tags":"environment,level,kind"}'
#
#   PagerDuty service (requires the PagerDuty integration installed):
#     SENTRY_ALERT_NOTIFICATION_ACTION='{"id":"sentry.integrations.pagerduty.notify_action.PagerDutyNotifyServiceAction","account":"<numeric account id>","service":"<PagerDuty service id>"}'
#
# Server-side only. Required for owner-runnable provisioning of rule 6.
# Owner's local env; NEVER commit a real value.
# SENTRY_ALERT_NOTIFICATION_ACTION=''
