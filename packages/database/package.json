{
    "name":  "@workspace/database",
    "version":  "0.0.0",
    "type":  "module",
    "private":  true,
    "scripts":  {
                    "lint":  "node ../eslint-config/node_modules/eslint/bin/eslint.js src --max-warnings 0",
                    "format":  "prettier --write \"**/*.{ts,tsx}\"",
                    "typecheck":  "tsc --noEmit"
                },
    "dependencies":  {
                         "@supabase/supabase-js":  "^2.49.4",
                         "@supabase/ssr":  "^0.6.1",
                         "@workspace/types":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/node":  "^25.1.0",
                            "next":  "16.1.6",
                            "@workspace/eslint-config":  "workspace:*",
                            "@workspace/typescript-config":  "workspace:*",
                            "typescript":  "^5.9.3"
                        },
    "exports":  {
                    ".":  "./src/index.ts",
                    "./client":  "./src/client.ts",
                    "./middleware":  "./src/middleware.ts",
                    "./supabase.types":  "./src/supabase.types.ts",
                    "./database.types":  "./src/database.types.ts",
                    "./repositories/*":  "./src/repositories/*.ts"
                }
}
